{
    "name":  "taskmaster",
    "version":  "1.0.0",
    "description":  "Taller MERN con pruebas (Jest + Cypress)",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "test:watch":  "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch",
                    "test":  "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest",
                    "test:cov":  "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage",
                    "cy:run":  "cypress run",
                    "start":  "node backend/server.js",
                    "dev":  "node --watch backend/server.js",
                    "cy:open":  "cypress open"
                },
    "devDependencies":  {
                            "@types/jest":  "^30.0.0",
                            "cross-env":  "^10.0.0",
                            "cypress":  "^15.3.0",
                            "jest":  "^30.1.3",
                            "mongodb-memory-server":  "^10.2.1",
                            "supertest":  "^7.1.4"
                        },
    "dependencies":  {
                         "jsonwebtoken":  "^9.0.2"
                     }
}
